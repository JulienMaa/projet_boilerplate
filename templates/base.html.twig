<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Home{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js" integrity="sha384-oBqDVmMz9ATKxIep9tiCxS/Z9fNfEXiDAYTujMAeBAsjFuCZSmKbSSUnQlmh/jp3" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js" integrity="sha384-cuYeSxntonz0PPNlHhBs68uyIAVpIIOZZ5JqeqvYYIcEL727kskC66kF92t6Xl2V" crossorigin="anonymous"></script>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="d-flex" id="wrapper">
            <!-- Sidebar -->
            <div id="sidebar-wrapper">
                <div class="sidebar-heading text-center">Admin Panel</div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('home') }}" class="list-group-item list-group-item-action">Home</a>
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_user_list') }}" class="list-group-item list-group-item-action">Users</a>
                        {% endif %}
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
                            <a href="{{ path('app_client_list') }}" class="list-group-item list-group-item-action">Clients</a>
                        {% endif %}
                        <a href="{{ path('app_product_list') }}" class="list-group-item list-group-item-action">Products</a>
                        <a href="{{ path('app_logout') }}" class="list-group-item list-group-item-action text-accent" id="logout">Log Out</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="list-group-item list-group-item-action">Log In</a>
                        <a href="{{ path('app_register') }}" class="list-group-item list-group-item-action">Registration</a>
                    {% endif %}
                </div>
            </div>
            <!-- Page Content -->
            <div id="page-content-wrapper" class="w-100 gradient-circular">
                <div class="container-fluid">
                    {% block body %}{% endblock %}
                </div>
                {% include '_footer.html.twig' %}
            </div>
        </div>
    </body>
</html>
