{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card bg-2 p-4">
                    <h3 class="text-center text-light mb-4">Create an Account</h3>

                    {{ form_errors(registrationForm) }}
                    
                    {{ form_start(registrationForm) }}
                        <div class="form-group text-mute">
                            {{ form_row(registrationForm.email, {
                                'attr': {'class': 'form-control', 'placeholder': 'Enter your email'}
                            }) }}
                        </div>

                        <br>

                        <div class="form-group text-mute">
                            {{ form_row(registrationForm.firstname, {
                                'attr': {'class': 'form-control', 'placeholder': 'Enter your first name'}
                            }) }}
                        </div>

                        <br>

                        <div class="form-group text-mute">
                            {{ form_row(registrationForm.lastname, {
                                'attr': {'class': 'form-control', 'placeholder': 'Enter your last name'}
                            }) }}
                        </div>

                        <br>

                        <div class="form-group text-mute">
                            {{ form_row(registrationForm.plainPassword, {
                                'label': 'Password',
                                'attr': {'class': 'form-control', 'placeholder': 'Enter your password'}
                            }) }}
                        </div>

                        <br>

                        <div class="form-group form-check text-mute">
                            {{ form_row(registrationForm.agreeTerms, {
                                'attr': {'class': 'form-check-input'}
                            }) }}
                            <label class="form-check-label text-light" for="registrationForm_agreeTerms">
                                I agree to the terms and conditions
                            </label>
                        </div>

                        <br>

                        <div class="form-group text-center">
                            <button type="submit" class="btn button-stylized btn-block">Register</button>
                        </div>
                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
