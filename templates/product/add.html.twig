{% extends 'base.html.twig' %}

{% block title %}Add Product{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card bg-2 p-4">
                    <h1 class="text-center text-light mb-4">Add Product</h1>

                    {{ form_start(form) }}

                    <div class="mb-3 text-mute">
                        {{ form_label(form.name, null, {'label_attr': {'class': 'form-label text-light'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control bg-dark text-light'}}) }}
                    </div>

                    <div class="mb-3 text-mute">
                        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label text-light'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control bg-dark text-light'}}) }}
                    </div>

                    <div class="mb-3 text-mute">
                        {{ form_label(form.price, null, {'label_attr': {'class': 'form-label text-light'}}) }}
                        {{ form_widget(form.price, {'attr': {'class': 'form-control bg-dark text-light'}}) }}
                    </div>

                    <div class="form-group text-center">
                        <button type="submit" class="btn button-stylized btn-block">
                            Add Product
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
