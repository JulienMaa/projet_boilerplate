{% extends 'base.html.twig' %}

{% block title %}Product List{% endblock %}

{% block body %}
    <div class="container mt-5 bg-transparent text-light">
        <h1 class="text-center mb-4 text-accent">Product List</h1>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_product_add') }}" class="btn button-stylized mb-3">Add Product</a>
            <a href="{{ path('app_product_export_csv') }}" class="btn btn-warning mb-3">Export to CSV</a>
        {% endif %}

        <div class="table-responsive">
            <table class="table bg-transparent text-light">
                <thead class="bg-accent text-light">
                    <tr>
                        <th class="bg-transparent">Name</th>
                        <th class="bg-transparent">Description</th>
                        <th class="bg-transparent">Price</th>
                        {% if is_granted('ROLE_ADMIN') %}
                            <th class="bg-transparent">Actions</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr>
                            <td class="text-highlight bg-transparent">{{ product.name }}</td>
                            <td class="text-mute bg-transparent">{{ product.description }}</td>
                            <td class="text-light bg-transparent">{{ product.price | number_format(2, '.', ',') }} €</td>
                            <td class="bg-transparent">
                                {% if is_granted('product_edit', product) %}
                                    <a href="{{ path('app_product_edit', { id: product.id }) }}" class="btn btn-sm btn-warning">Edit</a>
                                {% endif %}
                                {% if is_granted('product_delete', product) %}
                                    <form action="{{ path('app_product_delete', { id: product.id }) }}" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this product?');">Delete</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-mute bg-transparent">No products found</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
