{% extends 'base.html.twig' %}

{% block title %}Create Client{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card bg-2 p-4">
                    <h1 class="text-center text-light mb-4">Create Client</h1>

                    {{ form_start(form) }}

                    <div class="mb-3 text-mute">
                        {{ form_label(form.firstname, null, {'label_attr': {'class': 'form-label text-light'}}) }}
                        {{ form_widget(form.firstname, {'attr': {'class': 'form-control bg-dark text-light'}}) }}
                    </div>

                    <div class="mb-3 text-mute">
                        {{ form_label(form.lastname, null, {'label_attr': {'class': 'form-label text-light'}}) }}
                        {{ form_widget(form.lastname, {'attr': {'class': 'form-control bg-dark text-light'}}) }}
                    </div>

                    <div class="mb-3 text-mute">
                        {{ form_label(form.email, null, {'label_attr': {'class': 'form-label text-light'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control bg-dark text-light'}}) }}
                    </div>

                    <div class="mb-3 text-mute">
                        {{ form_label(form.phoneNumber, null, {'label_attr': {'class': 'form-label text-light'}}) }}
                        {{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control bg-dark text-light'}}) }}
                    </div>

                    <div class="mb-3 text-mute">
                        {{ form_label(form.address, null, {'label_attr': {'class': 'form-label text-light'}}) }}
                        {{ form_widget(form.address, {'attr': {'class': 'form-control bg-dark text-light'}}) }}
                    </div>

                    <div class="form-group text-center">
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
