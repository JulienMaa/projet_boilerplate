{% extends 'base.html.twig' %}

{% block title %}Client List{% endblock %}

{% block body %}
    <div class="container mt-5 bg-transparent text-light">
        <h1 class="text-center mb-4 text-accent">Client List</h1>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {% if is_granted('create_client') %}
            <a href="{{ path('app_client_new') }}" class="btn button-stylized mb-3">Add Client</a>
        {% endif %}

        <div class="table-responsive">
            <table class="table bg-transparent text-light">
                <thead class="bg-accent text-light">
                    <tr>
                        <th class="bg-transparent">First Name</th>
                        <th class="bg-transparent">Last Name</th>
                        <th class="bg-transparent">Email</th>
                        <th class="bg-transparent">Phone</th>
                        <th class="bg-transparent">Address</th>
                        <th class="bg-transparent">Created At</th>
                        {% if is_granted('edit_client') or is_granted('delete_client') %}
                            <th class="bg-transparent">Actions</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for client in clients %}
                        <tr>
                            <td class="text-light bg-transparent">{{ client.firstname }}</td>
                            <td class="text-light bg-transparent">{{ client.lastname }}</td>
                            <td class="text-highlight bg-transparent">{{ client.email }}</td>
                            <td class="text-mute bg-transparent">{{ client.phoneNumber }}</td>
                            <td class="text-light bg-transparent">{{ client.address }}</td>
                            <td class="text-light bg-transparent">{{ client.createdAt|date('Y-m-d H:i') }}</td>
                            <td class="bg-transparent">
                            {% if is_granted('edit_client') %}
                                    <a href="{{ path('app_client_edit', { id: client.id }) }}" class="btn btn-sm btn-warning">Edit</a>
                            {% endif %}
                            {% if is_granted('delete_client') %}
                                    <form action="{{ path('app_client_delete', { id: client.id }) }}" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this client?');">Delete</button>
                                    </form>
                            {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-mute bg-transparent">No clients found</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
